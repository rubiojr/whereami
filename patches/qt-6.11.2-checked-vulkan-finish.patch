 }
 
-void QRhiVulkan::ensureCommandPoolForNewFrame()
+QRhi::FrameOpResult QRhiVulkan::ensureCommandPoolForNewFrame()
 {
     VkCommandPoolResetFlags flags = 0;
 
@@ -2600,7 +2600,16 @@ void QRhiVulkan::ensureCommandPoolForNewFrame()
         flags |= VK_COMMAND_POOL_RESET_RELEASE_RESOURCES_BIT;
 
     // put all command buffers allocated from this slot's pool to initial state
-    df->vkResetCommandPool(dev, cmdPool[currentFrameSlot], flags);
+    const VkResult err = df->vkResetCommandPool(dev, cmdPool[currentFrameSlot], flags);
+    if (err != VK_SUCCESS) {
+        qWarning("Failed to reset command pool: %d", err);
+        if (err == VK_ERROR_DEVICE_LOST) {
+            deviceLost = true;
+            return QRhi::FrameOpDeviceLost;
+        }
+        return QRhi::FrameOpError;
+    }
+    return QRhi::FrameOpSuccess;
 }
 

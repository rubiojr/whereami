+        if (startResult != QRhi::FrameOpSuccess)
+            return finishError = startResult;
     }
 
     executeDeferredReleases(true);
@@ -3134,6 +3173,10 @@ QRhi::FrameOpResult QRhiVulkan::finish()
     return QRhi::FrameOpSuccess;
 }
 

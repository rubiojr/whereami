+        if (waitResult == VK_ERROR_DEVICE_LOST) {
+            deviceLost = true;
+            return finishError = QRhi::FrameOpDeviceLost;
+        }
+        return finishError = QRhi::FrameOpError;
+    }
 
     if (inFrame) {
         // The current frame slot's command pool needs to be reset.
-        ensureCommandPoolForNewFrame();
+        const QRhi::FrameOpResult resetResult = ensureCommandPoolForNewFrame();
+        if (resetResult != QRhi::FrameOpSuccess)
+            return finishError = resetResult;
         // Allocate and begin recording on a new command buffer.
+        QRhi::FrameOpResult startResult;
         if (ofr.active) {
-            startPrimaryCommandBuffer(&ofr.cbWrapper[currentFrameSlot]->cb);
+            startResult = startPrimaryCommandBuffer(&ofr.cbWrapper[currentFrameSlot]->cb);
         } else {
             QVkSwapChain::FrameResources &frame(swapChainD->frameRes[swapChainD->currentFrameSlot]);
-            startPrimaryCommandBuffer(&frame.cmdBuf);

@@ -3088,6 +3111,8 @@ QRhi::FrameOpResult QRhiVulkan::endOffscreenFrame(QRhi::EndFrameFlags flags)
 
 QRhi::FrameOpResult QRhiVulkan::finish()
 {
+    if (finishError != QRhi::FrameOpSuccess)
+        return finishError;
     QVkSwapChain *swapChainD = nullptr;
     if (inFrame) {

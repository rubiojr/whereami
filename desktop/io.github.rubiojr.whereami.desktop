[Desktop Entry]
Version=1.0
Type=Application
Name=WhereAmI
Comment=View, manage and bookmark GPX waypoints
Exec=whereami
Icon=io.github.rubiojr.whereami
# StartupNotify=true
Categories=Education;Maps;
Keywords=GPS;GPX;Waypoint;Map;Location;Bookmarks;
X-Geoclue-2-Client=true
X-Geoclue-2-Access-Fine=true
# Prefer Wayland if available; fallback to X11 automatically
# PrefersNonDefaultGPU=false
# If you later add translation (.desktop.in), wrap Name/Comment in gettext domains
StartupWMClass=whereami
X-GNOME-SingleWindow=true
# X-GNOME-SingleWindow is a desktop-shell hint. The application does not
# enforce a single instance.
